DB_PASSWORD=cambia-esta-password
DATABASE_URL=postgresql+psycopg://postgres:cambia-esta-password@localhost:5433/proyecto_gases
TEST_DATABASE_URL=postgresql+psycopg://postgres:cambia-esta-password@localhost:5433/proyecto_gases_test
JWT_SECRET=cambiame-en-produccion
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_HOURS=8
REFRESH_TOKEN_EXPIRE_DAYS=1
ENVIRONMENT=local
MLFLOW_TRACKING_URI=http://localhost:5000
# GCS_BUCKET=
# ETL inbox (APScheduler)
ETL_INBOX_ENABLED=false
ETL_INBOX_INTERVAL_SECONDS=60
ETL_INBOX_DIR=data/inbox
# Umbrales de riesgo (Plan 05)
RISK_THRESHOLD_PRECAUTION=0.3
RISK_THRESHOLD_ALERT=0.6
RISK_THRESHOLD_CRITICAL=0.85
PREDICTION_POST_ETL_LIMIT=500
PREDICTION_JOB_ENABLED=false
PREDICTION_JOB_INTERVAL_SECONDS=120
# Notificaciones (Plan 06) — dry_run=true no envía SMTP real
NOTIFICATIONS_DRY_RUN=true
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@plataforma-gases.local
# WHATSAPP_API_TOKEN=
# Reportes (Plan 08)
# REPORTS_DIR=storage/reports
# Model Zoo / thesis (Plan 12)
ML_LOOKBACK_STEPS=20
ML_LEAD_MINUTES_MIN=5
ML_LEAD_MINUTES_MAX=10
THESIS_RECALL_MIN=0.95
THESIS_PRECISION_MIN=0.90
THESIS_F1_MIN=0.92
THESIS_FN_MAX=0.05
THESIS_RMSE_MAX=0.05
# Superadmin (solo para scripts/create_superadmin.py — no versionar valores reales)
# SUPERADMIN_EMAIL=admin@example.com
# SUPERADMIN_PASSWORD=cambia-esta-password
# SUPERADMIN_FULL_NAME=Administrador
